 @media(max-height:500px){.valora-floating-v9 .valora-conversation__notices{max-height:58px;overflow:auto}.valora-floating-v9 .valora-concierge__chat{max-height:90px}.valora-floating-v9 .valora-concierge__greeting{padding:8px 12px;font-size:12px}}
 .valora-floating-v9-spacer{width:100%;pointer-events:none;visibility:hidden}
+
+/* Host legacy guide-finder styles must not reposition the floating dock. */
+#valora-floating-conversation{right:auto;top:auto;left:50%;transform:translateX(-50%);padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;bottom:max(18px,env(safe-area-inset-bottom));width:min(1100px,calc(100vw - 40px));max-height:calc(100dvh - 110px)}
+#valora-floating-conversation .valora-concierge__form{display:block;width:100%}
+#valora-floating-conversation .valora-conversation__composer{width:100%}
+#valora-floating-conversation .valora-concierge__greeting{align-self:stretch;max-width:none}
+#valora-floating-conversation .valora-concierge__answer{color:var(--ink)}
+@media(max-width:620px){#valora-floating-conversation{bottom:max(8px,env(safe-area-inset-bottom));width:calc(100vw - 16px);max-height:calc(100dvh - 80px)}}
+
+/* Opaque backing prevents host-page text bleeding between chat sections. */
+#valora-floating-conversation{background:#fff;border-radius:24px;box-shadow:0 8px 28px #0002}
