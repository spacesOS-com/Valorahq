+(function(){'use strict';const d=document.querySelector('#rootInquiryDialog');if(!d)return;let opener=null;function open(el){opener=el||document.activeElement;if(!d.open)d.showModal();const t=document.querySelector('#screen h1');if(t){t.tabIndex=-1;t.focus({preventScroll:true})}}document.addEventListener('click',e=>{const a=e.target.closest('a');if(!a)return;const u=new URL(a.href,location.href);if(u.origin===location.origin&&u.pathname==='/'&&u.hash==='#contact'){e.preventDefault();e.stopImmediatePropagation();open(a)}},true);d.querySelector('.inquiry-modal-close').onclick=()=>d.close();d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()}});d.addEventListener('close',()=>opener?.focus({preventScroll:true}));d.addEventListener('keydown',e=>{if(e.key!=='Tab')return;const items=[...d.querySelectorAll('a[href],button,input,textarea,[tabindex]')].filter(x=>!x.disabled&&x.tabIndex>=0&&x.getClientRects().length);const first=items[0],last=items.at(-1);if(e.shiftKey&&(document.activeElement===first||!items.includes(document.activeElement))){e.preventDefault();last?.focus()}else if(!e.shiftKey&&(document.activeElement===last||!items.includes(document.activeElement))){e.preventDefault();first?.focus()}});if(location.pathname==='/'&&location.hash==='#contact'){open();window.addEventListener('load',()=>requestAnimationFrame(()=>open()));}})();
