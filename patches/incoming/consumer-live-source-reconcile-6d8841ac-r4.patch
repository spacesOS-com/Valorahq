+(function(){'use strict';let step=0,values={},pending=false,receipt=null;const adapter=window.ValoraInquiryContractAdapter.create(async payload=>{const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),20000);try{return await fetch(document.querySelector('#flow').dataset.endpoint,{method:'POST',body:new URLSearchParams(payload),signal:controller.signal})}finally{clearTimeout(timer)}});let titles=['Start by introducing yourself.','How did you find Valora?','What is your estimated investable asset range?','What made planning a priority?','Inquiry received'];let helpers=['','Choose how you found Valora. This is self-reported, not verified attribution.','Include cash, savings, investments and retirement accounts. Exclude real estate and estimated business value. An estimate is enough; you can choose not to say.','What changed, and what would make a first conversation useful? A sentence is enough. You can leave this blank.',''];let sources=['Podcast','YouTube','Calculator','Search / website','Referral','Other'];let assets=['Less than $250,000','$250,000 to less than $1 million','$1 million to less than $2 million','$2 million to less than $5 million','$5 million to less than $10 million','$10 million to less than $25 million','$25 million or more','Prefer not to say'];function safe(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}const liveAnalytics=location.origin==='https://www.valorahq.com'&&location.pathname==='/'&&!window.__VALORA_INQUIRY_QA__;let observedStep=-1,viewObserver=null;const eventSteps={valora_inquiry_step_viewed:[1,2,3,4,5],valora_inquiry_continue_clicked:[1,2,3],valora_inquiry_submit_attempted:[4],valora_inquiry_submit_succeeded:[4],valora_inquiry_submit_unconfirmed:[4]};function funnel(name,n){if(!liveAnalytics||!eventSteps[name]?.includes(n))return;try{window.posthog?.capture(name,{step:n})}catch(_){}}function observeStep(){if(observedStep===step)return;observedStep=step;viewObserver?.disconnect();const n=step+1;viewObserver=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){funnel('valora_inquiry_step_viewed',n);viewObserver.disconnect()}},{threshold:0.5});viewObserver.observe(document.querySelector('#screen h1'));}function fields(){return '<div class="fields">'+[['first','First name','given-name','text'],['last','Last name','family-name','text'],['phone','Phone number','tel','tel'],['email','Email','email','email']].map(([id,label,auto,type])=>`<label>${label}${id==='phone'?' (optional)':''}<input name="${id}" autocomplete="${auto}" type="${type}" value="${safe(values[id])}" ${id==='phone'?'':'required'} maxlength="160"></label>`).join('')+'</div><p class="privacy"></p>'}function choices(options,key){return '<div class="choices ph-no-capture" role="radiogroup" aria-label="'+safe(titles[step])+'">'+options.map((x,i)=>`<button type="button" class="choice ph-no-capture" tabindex="${values[key]===x||(!values[key]&&i===0)?0:-1}" role="radio" data-key="${key}" data-value="${safe(x)}" aria-checked="${values[key]===x}"><b>${String.fromCharCode(65+i)}</b>${safe(x)}</button>`).join('')+'</div>'}function focusScreen(){const title=document.querySelector('#screen h1');title.tabIndex=-1;title.focus({preventScroll:true});document.querySelector('#contact').scrollIntoView({block:'start'});}function render(){document.querySelector('#contact').dataset.inquiryStep=String(step+1);document.querySelector('#progress').textContent='Step '+(step+1)+' of 5';let body=step===0?fields():step===1?choices(sources,'source'):step===2?choices(assets,'assets'):step===3?`<label class="ph-no-capture" for="priority">What would you like us to understand?<textarea class="ph-no-capture" id="priority" name="priority" maxlength="1000">${safe(values.priority)}</textarea></label><p class="privacy">Your note is optional. Please leave out account numbers, passwords and other private account details.</p>`:'<div class="inquiry-done"><p>Thank you. Valora will review your inquiry and email next steps. Timing may vary.</p></div>';document.querySelector('#screen').innerHTML='<div><h1>'+titles[step]+'</h1><p>'+helpers[step]+'</p></div><div>'+body+'</div>';document.querySelector('#back').hidden=step===0;document.querySelector('#next').hidden=step===4;document.querySelector('#next').disabled=pending;document.querySelector('#next').textContent=step===3?'Send my inquiry':'Continue';document.querySelector('#sendDisclosure').hidden=step!==3;document.querySelector('#back').hidden=step===0||step===4;document.querySelector('#error').textContent='';observeStep();document.querySelectorAll('.choice').forEach((b,i)=>{b.onclick=()=>{values[b.dataset.key]=b.dataset.value;render();document.querySelectorAll('.choice')[i].focus()};b.onkeydown=e=>{let delta=e.key==='ArrowDown'||e.key==='ArrowRight'?1:e.key==='ArrowUp'||e.key==='ArrowLeft'?-1:0;if(delta){e.preventDefault();let bs=document.querySelectorAll('.choice');bs[(i+delta+bs.length)%bs.length].click()}}});document.querySelectorAll('input,textarea').forEach(x=>x.oninput=()=>{document.querySelector('#error').textContent='';x.removeAttribute('aria-invalid');x.removeAttribute('aria-describedby')})}document.querySelector('#flow').onsubmit=e=>{e.preventDefault();if(step<3)funnel('valora_inquiry_continue_clicked',step+1);let valid=true;if(step===0||step===3){for(let x of document.querySelectorAll('input,textarea')){values[x.name]=x.value.trim();if(!x.checkValidity()||(x.required&&!values[x.name]))valid=false}}else if(step===1&&!values.source||step===2&&!values.assets)valid=false;if(!valid){document.querySelector('#error').textContent='Please complete this step before continuing.';let x=[...document.querySelectorAll('input,textarea')].find(x=>!x.checkValidity()||(x.required&&!x.value.trim()));if(x){x.setAttribute('aria-invalid','true');x.setAttribute('aria-describedby','error');x.focus()}else{document.querySelector('.choice')?.focus()}return}if(step===3){if(pending)return;funnel('valora_inquiry_submit_attempted',4);pending=true;document.querySelector('#next').disabled=true;document.querySelector('#next').textContent='Sending…';adapter.submit({firstName:values.first,lastName:values.last,email:values.email,phone:values.phone||'',sourceChoice:values.source,assetBand:values.assets,motivation:values.priority||'',reviewedNoticeAccepted:true}).then(result=>{pending=false;if(result.kind==='inquiryAccepted'){funnel('valora_inquiry_submit_succeeded',4);receipt=true;step=4;render();focusScreen();}else{if(result.kind==='unconfirmed')funnel('valora_inquiry_submit_unconfirmed',4);document.querySelector('#error').textContent=result.kind==='retryLater'?'Please wait before trying again.':result.kind==='invalid'?'Please check your details before sending.':'We could not confirm this request. Do not submit it again yet.';document.querySelector('#next').disabled=result.kind==='unconfirmed';document.querySelector('#back').disabled=result.kind==='unconfirmed';document.querySelector('#next').textContent='Send my inquiry';}});return;}step++;render();focusScreen()};document.querySelector('#back').onclick=()=>{if(pending)return;step--; render();focusScreen()};const contactObserver=new IntersectionObserver(entries=>{document.body.classList.toggle('root-inquiry-visible',entries.some(e=>e.isIntersecting))},{threshold:0});contactObserver.observe(document.querySelector('#contact'));render();
